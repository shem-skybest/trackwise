<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Trackwise.DbMigrator-82A1337E-CB55-438D-9286-5046D4E5149B</UserSecretsId>
    <LangVersion>default</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="SqlFunctions\*.psql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="SeedData\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Trackwise.Application\Trackwise.Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Trackwise.Infrastructure.Payments\Trackwise.Infrastructure.Payments.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Trackwise.Infrastructure.Persistence\Trackwise.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Trackwise.Infrastructure.Tax\Trackwise.Infrastructure.Tax.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Trackwise.Infrastructure.Integrations.FuelCards\Trackwise.Infrastructure.Integrations.FuelCards.csproj" />
  </ItemGroup>
</Project>
