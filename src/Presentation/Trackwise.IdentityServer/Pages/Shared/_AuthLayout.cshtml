@*
    spartan's login-two-column block. The form column runs on the card surface in light mode (the block
    is white there) and on the canvas in dark; --background is re-pointed rather than bg-card set, so
    the field separator's label, which paints bg-background over its rule, matches the column.
    A page widens its column with ViewData["AuthWidth"] (a full max-w-* class).
*@
@{
    Layout = "_Layout";
}

<div class="bg-background grid min-h-svh [--background:var(--bg-surface)] lg:grid-cols-2 dark:[--background:var(--bg-base)]">
    <div class="flex flex-col gap-4 p-6 md:p-10">
        <div class="flex justify-center gap-2 md:justify-start">
            <a href="~/" class="text-foreground hover:text-foreground flex items-center gap-2 font-medium">
                <img src="~/logo.png" alt="" class="size-8" />
                TrackWise
            </a>
        </div>
        <div class="flex flex-1 items-center justify-center">
            <div class="w-full @(ViewData["AuthWidth"] as string ?? "max-w-xs")">
                @RenderBody()
            </div>
        </div>
    </div>
    <div class="bg-muted relative hidden lg:block">
        <img src="~/img/login-side.jpg" alt=""
             class="absolute inset-0 h-full w-full object-cover object-[30%_center] dark:brightness-[0.8]" />
    </div>
</div>

@section scripts {
    @await RenderSectionAsync("scripts", required: false)
}
