@page
@model Trackwise.IdentityServer.Pages.Error.Index
@{
    ViewData["Title"] = "Error";
}

<div class="flex flex-col gap-6">
    <div class="flex flex-col items-center gap-1 text-center">
        <h1 class="mb-0 text-2xl font-bold">Something went wrong</h1>
        <p class="text-muted-foreground text-sm text-balance">Sorry, there was an error processing your request.</p>
    </div>

    @if (Model.View.Error != null)
    {
        <div hlm-alert variant="destructive">
            <div hlm-alert-title>@Model.View.Error.Error</div>
            @if (Model.View.Error.ErrorDescription != null)
            {
                <div hlm-alert-description>@Model.View.Error.ErrorDescription</div>
            }
        </div>
    }

    @if (Model?.View?.Error?.RequestId != null)
    {
        <p class="text-muted-foreground text-center text-xs">Request ID: @Model.View.Error.RequestId</p>
    }

    <a hlm-btn variant="outline" asp-page="/Account/Login/Index">Back to login</a>
</div>
