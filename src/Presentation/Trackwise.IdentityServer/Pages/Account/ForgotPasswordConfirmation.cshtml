@page
@model Trackwise.IdentityServer.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Check your email";
}

<div class="flex flex-col gap-6 text-center">
    <div class="flex flex-col items-center gap-1">
        <h1 class="mb-0 text-2xl font-bold">Check your email</h1>
        <p class="text-muted-foreground text-sm text-balance">If that email has an account, we've sent a link to reset its password.</p>
    </div>
    <a hlm-btn variant="outline" asp-page="/Account/Login/Index">Back to login</a>
</div>
