@page
@model Trackwise.IdentityServer.Pages.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
}

<div class="flex flex-col gap-6 text-center">
    <div class="flex flex-col items-center gap-1">
        <h1 class="mb-0 text-2xl font-bold">Confirm email</h1>
        <p class="text-muted-foreground text-sm text-balance">@Model.StatusMessage</p>
    </div>
    <a hlm-btn asp-page="/Account/Login/Index">Log in</a>
</div>
