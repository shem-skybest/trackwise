@page
@model Trackwise.IdentityServer.Pages.Account.Logout.Index
@{
    ViewData["Title"] = "Log out";
}

<form asp-page="/Account/Logout/Index">
    <input type="hidden" name="logoutId" value="@Model.LogoutId" />

    <div class="flex flex-col gap-6 text-center">
        <div class="flex flex-col items-center gap-1">
            <h1 class="mb-0 text-2xl font-bold">Log out</h1>
            <p class="text-muted-foreground text-sm text-balance">Do you want to log out of TrackWise?</p>
        </div>
        <button hlm-btn type="submit">Log out</button>
    </div>
</form>
