@page
@using Trackwise.IdentityServer.Pages.Account.Manage
@model Trackwise.IdentityServer.Pages.Account.Manage.Email.EmailModel
@{
    ViewData["Title"] = "Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<partial name="_StatusMessage" model="Model.StatusMessage" />

<form id="email-form" method="post">
    <div hlm-card>
        <div hlm-card-header>
            <div hlm-card-title>Email</div>
            <div hlm-card-description>The address you log in with. A new address gets a confirmation link before it takes effect.</div>
        </div>
        <div hlm-card-content>
            <div hlm-field-group class="max-w-md">
                <partial name="_ValidationSummary" />

                <div hlm-field>
                    <div class="flex items-center gap-2">
                        <label hlm-field-label asp-for="Email"></label>
                        @if (Model.IsEmailConfirmed)
                        {
                            <span hlm-badge variant="secondary">Confirmed</span>
                        }
                        else
                        {
                            <span hlm-badge variant="outline">Not confirmed</span>
                        }
                    </div>
                    <input hlm-input asp-for="Email" disabled />
                    @if (!Model.IsEmailConfirmed)
                    {
                        <button hlm-btn variant="link" size="sm" id="email-verification" type="submit"
                                asp-page-handler="SendVerificationEmail" class="w-fit px-0">Send verification email</button>
                    }
                </div>
                <div hlm-field>
                    <label hlm-field-label asp-for="Input.NewEmail"></label>
                    <input hlm-input asp-for="Input.NewEmail" autocomplete="email" />
                    <span hlm-field-error asp-validation-for="Input.NewEmail"></span>
                </div>
            </div>
        </div>
        <div hlm-card-footer class="border-t">
            <button hlm-btn id="change-email-button" type="submit" asp-page-handler="ChangeEmail">Change email</button>
        </div>
    </div>
</form>
