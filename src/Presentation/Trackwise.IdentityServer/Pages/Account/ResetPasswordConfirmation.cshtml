@page
@model Trackwise.IdentityServer.Pages.Account.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password reset";
}

<div class="flex flex-col gap-6 text-center">
    <div class="flex flex-col items-center gap-1">
        <h1 class="mb-0 text-2xl font-bold">Password reset</h1>
        <p class="text-muted-foreground text-sm text-balance">Your password has been changed. You can log in with it now.</p>
    </div>
    <a hlm-btn asp-page="/Account/Login/Index">Log in</a>
</div>
