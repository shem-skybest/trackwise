@page
@model Trackwise.IdentityServer.Pages.Account.LoginWithRecoveryCode.LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Recovery code";
}

<form method="post">
    <div hlm-field-group>
        <div class="flex flex-col items-center gap-1 text-center">
            <h1 class="mb-0 text-2xl font-bold">Use a recovery code</h1>
            <p class="text-muted-foreground text-sm text-balance">
                This login won't be remembered until you sign in with your authenticator app again.
            </p>
        </div>

        <partial name="_ValidationSummary" />

        <div hlm-field>
            <label hlm-field-label asp-for="Input.RecoveryCode">Recovery code</label>
            <input hlm-input asp-for="Input.RecoveryCode" autocomplete="off" autofocus />
            <span hlm-field-error asp-validation-for="Input.RecoveryCode"></span>
        </div>

        <div hlm-field>
            <button hlm-btn type="submit">Log in</button>
        </div>
    </div>
</form>
