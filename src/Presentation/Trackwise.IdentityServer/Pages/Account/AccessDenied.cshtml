@page
@model Trackwise.IdentityServer.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="flex flex-col gap-6 text-center">
    <div class="flex flex-col items-center gap-1">
        <h1 class="mb-0 text-2xl font-bold">Access denied</h1>
        <p class="text-muted-foreground text-sm text-balance">You don't have permission to open that page.</p>
    </div>
    <a hlm-btn variant="outline" asp-page="/Account/Login/Index">Back to login</a>
</div>
