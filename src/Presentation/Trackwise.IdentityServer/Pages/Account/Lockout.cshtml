@page
@model Trackwise.IdentityServer.Pages.Account.LockoutModel
@{
    ViewData["Title"] = "Locked out";
}

<div class="flex flex-col gap-6 text-center">
    <div class="flex flex-col items-center gap-1">
        <h1 class="text-destructive mb-0 text-2xl font-bold">Account locked</h1>
        <p class="text-muted-foreground text-sm text-balance">Too many failed attempts. Please try again later.</p>
    </div>
    <a hlm-btn variant="outline" asp-page="/Account/Login/Index">Back to login</a>
</div>
