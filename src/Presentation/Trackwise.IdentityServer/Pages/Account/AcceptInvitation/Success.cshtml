@page
@model Trackwise.IdentityServer.Pages.Account.AcceptInvitation.Success
@{
    ViewData["Title"] = "Welcome";
}

<div class="flex flex-col gap-6 text-center">
    <div class="flex flex-col items-center gap-2">
        <h1 class="mb-0 text-2xl font-bold">Welcome!</h1>
        <p class="text-muted-foreground text-sm text-balance">
            You've joined <strong class="text-foreground">@Model.TenantName</strong>
        </p>
        @if (!string.IsNullOrEmpty(Model.Role))
        {
            <span hlm-badge>@Model.Role</span>
        }
    </div>
    <p class="text-muted-foreground text-sm text-balance">You can now sign in to the portal with your email and password.</p>
    <a hlm-btn href="@Model.PortalUrl">Continue to portal</a>
</div>
