@page
@model Trackwise.IdentityServer.Pages.Account.Impersonate.Index
@{
    ViewData["Title"] = "Impersonation";
}

<div class="flex flex-col gap-6 text-center">
    <div class="flex flex-col items-center gap-1">
        <h1 class="mb-0 text-2xl font-bold">Starting impersonation</h1>
        <p class="text-muted-foreground text-sm text-balance">Please wait while we set up your session.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div hlm-alert variant="destructive" class="text-start">
            <div hlm-alert-description>@Model.ErrorMessage</div>
        </div>
    }
</div>
