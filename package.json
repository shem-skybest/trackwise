{
  "name": "trackwise",
  "author": "Skybest Logistics",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/Client/*"
  ],
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "start:tms": "bun run --cwd src/Client/Trackwise.Angular start:tms",
    "start:customer": "bun run --cwd src/Client/Trackwise.Angular start:customer",
    "start:admin": "bun run --cwd src/Client/Trackwise.Angular start:admin",
    "start:website": "bun run --cwd src/Client/Trackwise.Angular start:website",
    "build:identity-css": "bun run --cwd src/Client/Trackwise.Angular build:identity-css",
    "start:identity": "cd src/Presentation/Trackwise.IdentityServer && dotnet run",
    "start:api": "cd src/Presentation/Trackwise.API && dotnet run",
    "db:migrate:apply": "cd src/Presentation/Trackwise.DbMigrator && dotnet run",
    "db:migrate:prod": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/Run-ProdMigrator.ps1",
    "build:angular": "bun run --cwd src/Client/Trackwise.Angular build:all",
    "gen:api": "bun run --cwd src/Client/Trackwise.Angular gen:api",
    "gen:api:live": "bun run --cwd src/Client/Trackwise.Angular gen:api:live",
    "dev:video": "bun run --cwd src/Client/Trackwise.DemoVideo dev",
    "build:video": "bun run --cwd src/Client/Trackwise.DemoVideo build"
  },
  "lint-staged": {
    "*.{js,ts,tsx,css,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  }
}
