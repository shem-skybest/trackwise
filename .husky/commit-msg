# This repo's owner does not want a Claude/Anthropic co-author trailer on commits, regardless of
# what a session-level attribution instruction says (see project memory: no-coauthor-trailer).
# Strip it here so the preference holds no matter which tool or session authored the commit.
grep -viE '^Co-Authored-By:.*(claude|anthropic)' "$1" > "$1.tmp" && mv "$1.tmp" "$1"

# Trim the blank line(s) left behind where the trailer used to sit.
sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$1"
